(version 1)

# Sinhoo's SMTSO land pattern runs its ring pad to the edge of its own
# hole; JLCPCB pulls the copper back from an NPTH itself.
(rule "Standoff ring to its hole"
	(constraint hole_clearance (min 0mm))
	(condition "A.memberOfFootprint('oncore-jig:Sinhoo_SMTSO*') && B.memberOfFootprint('oncore-jig:Sinhoo_SMTSO*')"))

# H4's standoff holds the Oncore board up between J2's rows and the edge;
# the barrel clears J2's body.
(rule "H4 beside J2"
	(constraint courtyard_clearance (min -5mm))
	(condition "A.Reference == 'J2' && B.Reference == 'H4'"))

# The USB-C receptacle's face is flush with the edge, and its silk outline
# runs just past it.  The silk-to-edge check gives no edge item to match, so
# this also lifts J1's silk-to-silk clearance; keep references clear of it.
(rule "USB-C at the edge"
	(condition "A.memberOfFootprint('J1') || B.memberOfFootprint('J1')")
	(constraint silk_clearance)
	(severity ignore))
